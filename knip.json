{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"electron/*.cjs",
		"scripts/*.{ts,mjs,cjs}",
		"integrations/claude-code/godspeed/scripts/*.mjs",
		"src/server/workers/pdf-text-worker.mjs",
		"tests/**/*.test.{ts,tsx}",
		"tests/perf/*.{ts,tsx}"
	],
	"project": ["**/*.{ts,tsx,js,mjs,cjs}"],
	// globals.css loads it with `@import "tailwindcss"`, which knip does not read.
	"ignoreDependencies": ["tailwindcss"],
	// knip reads the `-c electron/electron-builder.yml` argument in release.yml as a binary.
	"ignoreBinaries": ["electron/electron-builder.yml"]
}
