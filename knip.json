{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"scripts/*.{ts,mjs,cjs}",
		"crates/services/folder-files/*.mjs",
		"tests/**/*.test.{ts,tsx}",
		"tests/perf/*.{ts,tsx}"
	],
	"project": ["**/*.{ts,tsx,js,mjs,cjs}"],
	// globals.css loads it with `@import "tailwindcss"`, which knip does not read.
	"ignoreDependencies": ["tailwindcss"]
}
