		"email": "255718537+amosblomqvist@users.noreply.github.com"
	},
	"homepage": "https://github.com/bayshores/godspeed",
	"desktopName": "godspeed.desktop",
	"description": "An agent harness for learning: adaptive teaching, practice, and a persistent knowledge graph.",
	"type": "module",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "NODE_ENV=test tsx --test tests/*.test.ts tests/*.test.tsx",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"deadcode": "knip",
		"check": "npm run typecheck && npm test && npm run lint && npm run deadcode",
		"desktop:dev": "concurrently -k \"next dev\" \"LH_DEV_URL=http://localhost:3000 electron .\"",
		"dev:fresh": "bash scripts/dev-fresh.sh",
		"desktop:local": "rm -rf dist .next/standalone && node scripts/fetch-model.mjs && next build && node scripts/build-server.mjs && electron-builder -c electron/electron-builder.yml --mac --arm64 --dir -c.mac.identity=null -c.mac.notarize=false --publish never",
		"desktop:dist": "rm -rf dist .next/standalone && node scripts/fetch-model.mjs && next build && node scripts/build-server.mjs && node scripts/smoke-server.mjs && DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} APPLE_KEYCHAIN_PROFILE=LH_NOTARY APPLE_TEAM_ID=TM8Y622C8X electron-builder -c electron/electron-builder.yml --mac --arm64"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@huggingface/transformers": "^4.3.2",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@mozilla/readability": "^0.6.0",
		"@napi-rs/canvas": "^1.0.9",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@resvg/resvg-js": "^2.6.2",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-zoom": "^3.0.0",
		"dagre-d3-es": "7.0.14",
		"electron-updater": "^6.8.9",
		"font-list": "^2.0.1",
		"katex": "0.18.2",
		"linkedom": "^0.18.13",
		"lucide-react": "^1.33.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-math": "3.0.0",
		"mermaid": "^11.17.0",
		"micromark-extension-math": "3.1.0",
		"minisearch": "^7.2.0",
		"motion": "^13.1.1",
		"next": "^16.3.2",
		"pdfjs-dist": "^6.3.289",
		"puppeteer-core": "^25.8.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-breaks": "^4.0.0",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"turndown": "^7.2.4",
		"typebox": "^1.3.27",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.4.3"
	},
	"overrides": {
		"katex": "$katex"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^16.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "^8.68.0",
		"app-builder-lib": "26.16.1",
		"concurrently": "^10.0.5",
		"electron": "^44.9.3",
		"electron-builder": "26.16.1",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"js-yaml": "^4.3.2",
		"knip": "5.88.1",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
