{
	"name": "godspeed",
	"version": "0.5.50",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Amos Blomqvist",
		"email": "255718537+amosblomqvist@users.noreply.github.com"
	},
	"homepage": "https://github.com/bayshores/godspeed",
	"desktopName": "godspeed.desktop",
	"description": "An agent harness for learning: adaptive teaching, practice, and a persistent knowledge graph.",
	"type": "module",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "node scripts/dev-resources.mjs && concurrently -k -n api,ui \"cargo build -p gs-server && cd .dev-resources && PORT=$((${PORT:-3000}+1000)) LH_DATA_DIR=\\\"${LH_DATA_DIR:-$INIT_CWD/data}\\\" ../target/debug/godspeed-server\" \"vite\"",
		"desktop:dev": "node scripts/dev-resources.mjs && cargo build -p gs-server && concurrently -k -n ui,app \"vite --host 127.0.0.1\" \"TAURI_APP_PATH=crates/shell tauri dev\"",
		"build": "vite build",
		"desktop:local": "node scripts/fetch-model.mjs && node scripts/fetch-pdfium.mjs && TAURI_APP_PATH=crates/shell tauri build -c crates/shell/tauri.bundle.conf.json --bundles app --no-sign",
		"desktop:dist": "bash scripts/mac-dist.sh",
		"test": "NODE_ENV=test tsx --test tests/*/*.test.ts tests/*/*.test.tsx",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"deadcode": "knip",
		"check": "npm run typecheck && npm test && npm run lint && npm run deadcode && npm run rust:check",
		"rust:check": "cargo test --workspace && cargo test -p gs-shell --features screens --bin godspeed screens:: && cargo clippy --workspace --all-targets -- -D warnings && cargo clippy -p gs-shell --features screens --all-targets -- -D warnings && cargo clippy -p gs-shell --features self-test --all-targets -- -D warnings && cargo machete",
		"dev:fresh": "bash scripts/dev-fresh.sh"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@cortex-js/compute-engine": "0.185.1",
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@huggingface/transformers": "^4.3.2",
		"@lezer/highlight": "^1.2.5",
		"@modelcontextprotocol/server": "^2.4.0",
		"@mozilla/readability": "^0.6.0",
		"@napi-rs/canvas": "^1.0.9",
		"@replit/codemirror-vim": "^6.4.0",
		"@resvg/resvg-js": "^2.6.2",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"d3-shape": "^3.2.0",
		"dagre-d3-es": "7.0.14",
		"electron-updater": "^6.8.11",
		"font-list": "^2.0.1",
		"katex": "0.18.2",
		"linkedom": "^0.18.13",
		"mathlive": "0.111.1",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-math": "3.0.0",
		"mermaid": "^11.17.0",
		"micromark-extension-math": "3.1.0",
		"minisearch": "^7.2.0",
		"motion": "^13.1.1",
		"next": "^16.4.3",
		"pdfjs-dist": "^6.3.289",
		"puppeteer-core": "^25.8.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1",
		"remark-breaks": "^4.0.0",
		"sharp": "^0.35.5",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"turndown": "^7.2.4",
		"typebox": "^1.3.27",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.4.3"
	},
	"overrides": {
		"katex": "$katex"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "^8.68.0",
		"@vitejs/plugin-react": "^6.1.2",
		"app-builder-lib": "26.16.1",
		"concurrently": "^10.0.5",
		"electron": "^44.10.0",
		"electron-builder": "26.16.1",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"js-yaml": "^4.3.2",
		"knip": "5.88.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vite": "^8.3.5"
	}
}
