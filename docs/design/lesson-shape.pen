              ]
            },
            {
              "type": "frame",
              "id": "QkCSc",
              "name": "What changes by kind of learner",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "tPaS8",
                  "name": "Caption",
                  "fill": "#222220",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What changes by kind of learner",
                  "lineHeight": 1.4,
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "KyFBZ",
                  "name": "Note",
                  "fill": "#5C5A52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A student with class files gets the printed problem and its page key. A person learning for a job gets the editor. A person with no files at all gets the same page: text, a question, the writing row. Nothing on the page depends on having a syllabus.\n\nNot drawn yet: the teacher's panel open beside the lesson, a plot with a slider, a question that came through broken, pictures attached to an answer.",
                  "lineHeight": 1.4,
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "InIn3",
          "name": "Pictures 5",
          "width": "fill_container",
          "gap": 40,
          "padding": [
            0,
            48
          ],
