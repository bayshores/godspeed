          "width": "fill_container",
          "gap": 40,
          "padding": [
            0,
            48
          ],
          "children": [
            {
              "type": "frame",
              "id": "NiYMT",
              "name": "Wide window: a written answer",
              "width": 987,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "jWJlF",
