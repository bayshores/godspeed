          "children": [
            {
              "type": "frame",
              "id": "p0RQ5A",
              "name": "The smallest window, 640 by 600: the problem folds to one line",
              "width": 640,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
