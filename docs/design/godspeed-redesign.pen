                  "fontSize": 14.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "gnYpx",
                  "name": "Line",
                  "fill": "$g-text-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Countdown: \"in N days\", then HH:MM:SS in the last 24h, then MM:SS.hh in the last hour; fades grey → red over the last 24h",
                  "lineHeight": 1.5,
                  "fontFamily": "$g-ui",
                  "fontSize": 14.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "bzaLn",
                  "name": "Line",
                  "fill": "$g-text-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "5 · Teacher: white dot with anime expressions, plain black eyes, named Halley",
                  "lineHeight": 1.5,
                  "fontFamily": "$g-ui",
                  "fontSize": 14.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "xpKkb",
                  "name": "Line",
