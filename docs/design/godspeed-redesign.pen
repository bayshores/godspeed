                  "fontFamily": "$g-ui",
                  "fontSize": 16,
                  "fontWeight": "800"
                },
                {
                  "type": "text",
                  "id": "Jd6ee",
                  "name": "Line",
                  "fill": "$g-text-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every lesson's class card gets today's date and time, plus that class's next items with days left and the files they cover. The agent uses it to choose what to teach first. It doesn't nag about deadlines.",
                  "lineHeight": 1.5,
                  "fontFamily": "$g-ui",
                  "fontSize": 14.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
