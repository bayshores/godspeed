                                {
                                  "type": "text",
                                  "id": "gnqyf",
                                  "name": "He has to be able to tru",
                                  "fill": "#CFCFCF",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "He has to be able to trust you completely; one confidently delivered hallucination poisons that. The deeper risk isn't a wrong name or date, it's a wrong understanding.",
