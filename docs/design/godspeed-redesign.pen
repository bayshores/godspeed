                      "name": "b",
                      "fill": "$g-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One call per class, plus one short call per lesson.",
                      "lineHeight": 1.4,
                      "fontFamily": "$g-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
