                  "lineHeight": 1.5,
                  "fontFamily": "$g-ui",
                  "fontSize": 14.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "z65k9d",
                  "name": "Line",
                  "fill": "$g-text-2",
                  "textGrowth": "fixed-width",
