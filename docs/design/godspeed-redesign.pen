                },
                {
                  "type": "text",
                  "id": "VQIWP",
                  "x": 32,
                  "y": 54,
                  "name": "Tag note",
                  "fill": "#8D8D8D",
                  "content": "The file's text drifts up past a reading line. Each sentence that crosses it sends a thread to the fact it became, and the facts join up into your graph.",
                  "fontFamily": "Source Sans 3",
                  "fontSize": 13.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "yjg09",
                  "x": 56,
                  "y": 150,
                  "name": "Text line",
                  "fill": "#1E1E1E",
                  "content": "Probability began with games of chance.",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "P7BY8I",
                  "x": 56,
                  "y": 190,
                  "name": "Text line",
                  "fill": "#3A3A3A",
                  "content": "An experiment is a procedure that yields",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Exp7W",
                  "x": 56,
                  "y": 230,
                  "name": "Text line",
                  "fill": "#3A3A3A",
                  "content": "one of a given set of possible outcomes.",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "cgQh6",
                  "x": 56,
                  "y": 270,
                  "name": "Text line",
                  "fill": "#8D8D8D",
                  "content": "The sample space S of an experiment is",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "eOLer",
                  "x": 56,
                  "y": 310,
                  "name": "Text line",
                  "fill": "#8D8D8D",
                  "content": "the set of all possible outcomes.",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "jHIFF",
                  "x": 56,
                  "y": 350,
                  "name": "Text line",
                  "fill": "#FFFFFF",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "color": "#FFFFFF59",
                    "blur": 14
                  },
                  "content": "An event E is a subset of the sample space.",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "j1MDRe",
                  "x": 56,
                  "y": 390,
                  "name": "Text line",
                  "fill": "#8D8D8D",
                  "content": "If S is finite and its outcomes are equally",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "PAcdC",
                  "x": 56,
                  "y": 430,
                  "name": "Text line",
                  "fill": "#8D8D8D",
                  "content": "likely, then p(E) = |E| / |S|.",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Edktw",
                  "x": 56,
                  "y": 470,
                  "name": "Text line",
                  "fill": "#3A3A3A",
                  "content": "Example 1. An urn holds four blue balls",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rtfp5",
                  "x": 56,
                  "y": 510,
                  "name": "Text line",
                  "fill": "#3A3A3A",
                  "content": "and five red balls. What is the chance",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "G3KS5s",
                  "x": 56,
                  "y": 550,
                  "name": "Text line",
                  "fill": "#1E1E1E",
                  "content": "that a ball chosen at random is blue?",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "e8Zan",
                  "x": 56,
                  "y": 590,
                  "name": "Text line",
                  "fill": "#1E1E1E",
                  "content": "Solution. Nine outcomes, four of them blue,",
                  "fontFamily": "STIX Two Text",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
