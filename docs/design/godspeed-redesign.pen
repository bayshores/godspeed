    {
      "type": "frame",
      "id": "UQunJ",
      "x": 2988,
      "y": 30820,
      "name": "10b · Class identity: round 2, hybrids",
      "fill": "#000000",
      "layout": "vertical",
      "gap": 36,
      "padding": 48,
      "children": [
        {
          "type": "text",
          "id": "D0IsO",
          "name": "Board title",
          "fill": "#E6E6E6",
          "content": "10b · Class identity, round 2: hybrids",
          "fontFamily": "Source Sans 3",
          "fontSize": 28,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "IWhCY",
          "name": "Board note",
          "fill": "#8D8D8D",
          "textGrowth": "fixed-width",
          "width": 1400,
          "content": "From your notes: mix them, keep progress in it, the picture must fit the subject (stars said nothing about a C class), and it must work for biology or history too. So the agent picks the class's signature from three kinds that fit any subject: math (real LaTeX), code, or a line of text (a quote, a sequence, a date). The signature is the progress: it inks in as you study. Halley's note says what's next.",
          "lineHeight": 1.4,
          "fontFamily": "Source Sans 3",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "q3AhS",
          "name": "H1",
          "gap": 32,
          "children": [
            {
              "type": "frame",
              "id": "PBcG7",
              "name": "Explain",
              "width": 340,
              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "text",
                  "id": "VY7Eo",
                  "name": "Option",
                  "fill": "$g-text",
                  "content": "H1 · Inks in as you learn",
                  "fontFamily": "$g-ui",
                  "fontSize": 24,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "tQ1z6",
                  "name": "What you see",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "z3KClg",
                      "name": "h",
                      "fill": "$g-text-3",
                      "content": "What you see",
                      "fontFamily": "$g-ui",
                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "YMW3h",
                      "name": "b",
                      "fill": "$g-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The class's signature beside its name. It starts as a faint grey outline and fills in white, left to right, as you study the class's facts. Under the name, one line from Halley about what's next.",
                      "lineHeight": 1.4,
                      "fontFamily": "$g-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "CXIFc",
                  "name": "What the agent does",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "z4r9oI",
                      "name": "h",
                      "fill": "$g-text-3",
                      "content": "What the agent does",
                      "fontFamily": "$g-ui",
                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "zKRry",
                      "name": "b",
                      "fill": "$g-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Once at setup: picks the signature and its kind (math, code or text). After each lesson: rewrites Halley's line.",
                      "lineHeight": 1.4,
                      "fontFamily": "$g-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mOMLR",
                  "name": "Cost",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "CkBOX",
                      "name": "h",
