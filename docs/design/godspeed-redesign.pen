                      "type": "text",
                      "id": "yCTZ0",
                      "name": "Ask one question at a time, ",
                      "fill": "#24231F",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ask one question at a time, and only about what the lesson just covered.",
                      "lineHeight": 1.6,
