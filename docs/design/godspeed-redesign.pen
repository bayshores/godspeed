                                  "name": "These govern check quest",
                                  "fill": "#CFCFCF",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "These govern check questions. Predictions have their own rules and deliberately break the first one.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "f6kn9",
                                  "name": "1. Answerable from what ",
                                  "fill": "#CFCFCF",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "1. Answerable from what was just taught. A check never needs a fact he hasn't been given.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "G8qSrE",
                                  "name": "2. One idea per question",
                                  "fill": "#CFCFCF",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "2. One idea per question. If the answer needs two steps, ask two questions.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "SRkr1",
                                  "name": "3. Always ask about unit",
                                  "fill": "#FFFFFF",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "3. Always ask about units when the problem has them.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
                                }
