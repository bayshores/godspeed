                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "7 · Halley, the comet teacher: rests bottom-right, flies with a trail to what it changes, Follow, click panel, edge cases",
                  "lineHeight": 1.5,
                  "fontFamily": "$g-ui",
                  "fontSize": 14.5,
                  "fontWeight": "normal"
                }
              ]
