                        "position": 1
                      }
                    ]
                  },
                  "width": 560,
                  "height": 60
                },
                {
                  "type": "rectangle",
                  "id": "N2xBG",
                  "x": 609,
                  "y": 162,
                  "name": "Rail mark",
                  "fill": "#3A3A3A",
                  "width": 1,
                  "height": 21
                },
                {
                  "type": "rectangle",
