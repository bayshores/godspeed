#!/bin/sh
# An early warning before the commit exists. The gate is GitHub's rule on main (docs/checks.md).
cd "$(git rev-parse --show-toplevel)" || exit 1
# Quiet when it passes: the full output is only worth reading on a failure.
out=$(npm run --silent --if-present check:fast 2>&1) || {
	printf '%s\n' "$out"
	exit 1
}
