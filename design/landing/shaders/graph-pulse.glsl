// Landing graph pulses: light travels along each "learn this first" arrow
// and every topic breathes a halo in its color. Generated by graphgen.cjs
// from the same data as the graph shapes. Design space 820 x 860.
precision highp float;

/** @resolution */
uniform vec2 u_res;

/** @time */
uniform float u_time;

/**
 * @label Pulse speed
 * @default 0.35
 * @range 0, 2
 */
uniform float u_speed;

/**
 * @label Halo strength
 * @default 0.5
 * @range 0, 1
 */
uniform float u_halo;

void edgeAt(int i, out vec2 p0, out vec2 p1, out vec2 p2, out vec2 p3, out vec3 c) {
	p0 = vec2(0.0); p1 = p0; p2 = p0; p3 = p0; c = vec3(1.0);
	if (i == 0) { p0 = vec2(143.0,123.0); p1 = vec2(202.5,123.0); p2 = vec2(202.5,90.0); p3 = vec2(262.0,90.0); c = vec3(0.063,0.725,0.506); return; }
	if (i == 1) { p0 = vec2(143.0,123.0); p1 = vec2(205.0,123.0); p2 = vec2(205.0,214.0); p3 = vec2(267.0,214.0); c = vec3(0.518,0.800,0.086); return; }
	if (i == 2) { p0 = vec2(320.0,90.0); p1 = vec2(381.0,90.0); p2 = vec2(381.0,58.0); p3 = vec2(442.0,58.0); c = vec3(0.976,0.451,0.086); return; }
	if (i == 3) { p0 = vec2(315.0,214.0); p1 = vec2(378.5,214.0); p2 = vec2(378.5,58.0); p3 = vec2(442.0,58.0); c = vec3(0.976,0.451,0.086); return; }
	if (i == 4) { p0 = vec2(320.0,90.0); p1 = vec2(381.5,90.0); p2 = vec2(381.5,288.0); p3 = vec2(443.0,288.0); c = vec3(0.976,0.451,0.086); return; }
	if (i == 5) { p0 = vec2(496.0,58.0); p1 = vec2(555.5,58.0); p2 = vec2(555.5,91.0); p3 = vec2(615.0,91.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 6) { p0 = vec2(661.0,91.0); p1 = vec2(707.0,91.0); p2 = vec2(707.0,179.0); p3 = vec2(753.0,179.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 7) { p0 = vec2(495.0,288.0); p1 = vec2(555.0,288.0); p2 = vec2(555.0,91.0); p3 = vec2(615.0,91.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 8) { p0 = vec2(495.0,288.0); p1 = vec2(624.0,288.0); p2 = vec2(624.0,179.0); p3 = vec2(753.0,179.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 9) { p0 = vec2(139.0,377.0); p1 = vec2(291.0,377.0); p2 = vec2(291.0,288.0); p3 = vec2(443.0,288.0); c = vec3(0.976,0.451,0.086); return; }
	if (i == 10) { p0 = vec2(139.0,377.0); p1 = vec2(203.0,377.0); p2 = vec2(203.0,475.0); p3 = vec2(267.0,475.0); c = vec3(0.918,0.702,0.031); return; }
	if (i == 11) { p0 = vec2(315.0,475.0); p1 = vec2(379.0,475.0); p2 = vec2(379.0,288.0); p3 = vec2(443.0,288.0); c = vec3(0.976,0.451,0.086); return; }
	if (i == 12) { p0 = vec2(143.0,123.0); p1 = vec2(292.0,123.0); p2 = vec2(292.0,564.0); p3 = vec2(441.0,564.0); c = vec3(0.063,0.725,0.506); return; }
	if (i == 13) { p0 = vec2(497.0,564.0); p1 = vec2(555.5,564.0); p2 = vec2(555.5,399.0); p3 = vec2(614.0,399.0); c = vec3(0.918,0.702,0.031); return; }
	if (i == 14) { p0 = vec2(662.0,399.0); p1 = vec2(706.5,399.0); p2 = vec2(706.5,454.0); p3 = vec2(751.0,454.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 15) { p0 = vec2(497.0,564.0); p1 = vec2(555.5,564.0); p2 = vec2(555.5,619.0); p3 = vec2(614.0,619.0); c = vec3(0.518,0.800,0.086); return; }
	if (i == 16) { p0 = vec2(662.0,619.0); p1 = vec2(706.5,619.0); p2 = vec2(706.5,454.0); p3 = vec2(751.0,454.0); c = vec3(0.902,0.902,0.902); return; }
	if (i == 17) { p0 = vec2(138.0,607.0); p1 = vec2(289.5,607.0); p2 = vec2(289.5,564.0); p3 = vec2(441.0,564.0); c = vec3(0.063,0.725,0.506); return; }
	if (i == 18) { p0 = vec2(138.0,607.0); p1 = vec2(445.0,607.0); p2 = vec2(445.0,731.0); p3 = vec2(752.0,731.0); c = vec3(0.063,0.725,0.506); return; }
}

void nodeAt(int i, out vec2 pos, out float r, out vec3 c) {
	pos = vec2(0.0); r = 0.0; c = vec3(1.0);
	if (i == 0) { pos = vec2(114.0,123.0); r = 25.0; c = vec3(0.063,0.725,0.506); return; }
	if (i == 1) { pos = vec2(292.0,90.0); r = 24.0; c = vec3(0.063,0.725,0.506); return; }
	if (i == 2) { pos = vec2(292.0,214.0); r = 19.0; c = vec3(0.518,0.800,0.086); return; }
	if (i == 3) { pos = vec2(470.0,58.0); r = 22.0; c = vec3(0.976,0.451,0.086); return; }
	if (i == 4) { pos = vec2(639.0,91.0); r = 18.0; c = vec3(0.353,0.353,0.353); return; }
	if (i == 5) { pos = vec2(777.0,179.0); r = 18.0; c = vec3(0.353,0.353,0.353); return; }
	if (i == 6) { pos = vec2(470.0,288.0); r = 21.0; c = vec3(0.976,0.451,0.086); return; }
	if (i == 7) { pos = vec2(114.0,377.0); r = 21.0; c = vec3(0.063,0.725,0.506); return; }
	if (i == 8) { pos = vec2(292.0,475.0); r = 19.0; c = vec3(0.918,0.702,0.031); return; }
	if (i == 9) { pos = vec2(470.0,564.0); r = 23.0; c = vec3(0.063,0.725,0.506); return; }
	if (i == 10) { pos = vec2(639.0,399.0); r = 19.0; c = vec3(0.918,0.702,0.031); return; }
	if (i == 11) { pos = vec2(777.0,454.0); r = 20.0; c = vec3(0.353,0.353,0.353); return; }
	if (i == 12) { pos = vec2(639.0,619.0); r = 19.0; c = vec3(0.518,0.800,0.086); return; }
	if (i == 13) { pos = vec2(114.0,607.0); r = 20.0; c = vec3(0.918,0.702,0.031); return; }
	if (i == 14) { pos = vec2(777.0,731.0); r = 19.0; c = vec3(0.063,0.725,0.506); return; }
}

vec2 bez(vec2 a, vec2 b, vec2 c, vec2 d, float t) {
	float u = 1.0 - t;
	return u * u * u * a + 3.0 * u * u * t * b + 3.0 * u * t * t * c + t * t * t * d;
}

void main() {
	float scale = 820.0 / u_res.x;
	vec2 p = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y) * scale;
	vec3 col = vec3(0.0);
	float alpha = 0.0;

	for (int i = 0; i < 19; i++) {
		vec2 p0; vec2 p1; vec2 p2; vec2 p3; vec3 c;
		edgeAt(i, p0, p1, p2, p3, c);
		float t = fract(u_time * u_speed * 0.5 + float(i) * 0.137);
		for (int k = 0; k < 6; k++) {
			float tk = t - float(k) * 0.025;
			if (tk < 0.0) continue;
			float d = length(p - bez(p0, p1, p2, p3, tk));
			float fall = 1.0 - float(k) / 6.0;
			float g = exp(-d / (k == 0 ? 3.5 : 2.5)) * fall;
			vec3 pc = mix(vec3(1.0), c, smoothstep(0.0, 0.7, tk));
			col += pc * g;
			alpha += g;
		}
	}

	for (int i = 0; i < 15; i++) {
		vec2 pos; float r; vec3 c;
		nodeAt(i, pos, r, c);
		float d = length(p - pos);
		float b = 0.6 + 0.4 * sin(u_time * 1.4 + float(i) * 2.1);
		float g = exp(-max(d - r, 0.0) / 14.0) * step(r - 1.0, d) * u_halo * b;
		col += c * g;
		alpha += g;
	}

	alpha = clamp(alpha, 0.0, 1.0);
	gl_FragColor = vec4(min(col, vec3(alpha)), alpha);
}
