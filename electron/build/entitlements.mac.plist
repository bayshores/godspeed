<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime entitlements (applied once the app is signed).
	     allow-jit: Electron's V8 JIT needs it under hardened runtime.
	     allow-unsigned-executable-memory is left out on purpose: modern
	     Electron does not need it, and it weakens the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>