{
  "identifier": "main",
  "webviews": ["main"],
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "allow-expand-window",
    "allow-show-window",
    "allow-get-zoom",
    "allow-set-zoom",
    "allow-zoom-step",
    "allow-zoom-reset",
    "allow-start-drag",
    "allow-toggle-menu",
    "allow-open-link",
    "allow-pick-folder",
    "allow-show-in-folder",
    "allow-open-path",
    "allow-open-agent",
    "allow-report-bug",
    "allow-list-fonts",
    "allow-print-pdf",
    "allow-drag-paths",
    "allow-title-bar-double-click"
  ]
}
